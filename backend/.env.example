# Copy to .env for your own PC. On the live server these go into the host's environment variables.

# ---- database --------------------------------------------------------------
# Local MySQL: mysql+pymysql://USER:PASSWORD@localhost:3306/lab_db?charset=utf8mb4
# TiDB Cloud (free, MySQL compatible): mysql+pymysql://USER:PASSWORD@HOST:4000/DBNAME  and set DB_SSL=true
DATABASE_URL=sqlite:///./lab.db
DB_SSL=false

# ---- security (the server refuses to start in production with the example values) ----
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string-of-40-characters
DEVICE_KEY=change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
TOKEN_HOURS=10
TIMEZONE=Asia/Kolkata

# ---- web address of the live site (used in e-mails and QR links) ----
PUBLIC_URL=
CORS_ORIGINS=http://localhost:5173

# ---- e-mail: smtp (your own PC) or gmail_api (free cloud hosts block SMTP) ----
EMAIL_PROVIDER=smtp
MAIL_FROM_NAME=Electronics Department
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# ---- reminders ----
REMINDER_INTERVAL_MIN=60
CRON_TOKEN=

# ---- issue verification (defaults) ----
CODE_MINUTES=5
CODE_MAX_ATTEMPTS=3
CODE_COOLDOWN_SEC=10
SCAN_VALID_MIN=10

# ---- first laboratory (created automatically on the first start) ----
DEFAULT_LAB_NAME=Electronics Laboratory
DEFAULT_LAB_CODE=ELEC
